---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const photos = (await getCollection("blueskyImages")).map((col) => col.data);

const minimalPhotoData = photos.map((photo) => ({
  postUrl: photo.postUrl,
  images: photo.images.map((image) => ({
    thumb: image.thumb,
    alt: image.alt,
  })),
}));

const initialPhotos = minimalPhotoData.slice(0, 20); // Load initial 20 photos
const remainingPhotos = minimalPhotoData.slice(20); // Remaining photos
---

<Layout pageTitle="Photos!">
  <div class="masonry" id="masonry">
    {
      initialPhotos.map((photo) =>
        photo.images.map((image) => (
          <div class="masonry-item">
            <a href={photo.postUrl} target="_blank">
              <img loading="lazy" src={image.thumb} alt={image.alt} />
            </a>
          </div>
        )),
      )
    }
  </div>
  <div images-data={JSON.stringify(remainingPhotos)} id="load-more"></div>
</Layout>

<script>
  const photos = JSON.parse(document.getElementById("load-more")?.getAttribute("images-data") ?? "[]");
  let loadedPhotos = 0;

  const loadMorePhotos = () => {
    const masonry = document.getElementById("masonry");
    const newPhotos = photos.slice(loadedPhotos, loadedPhotos + 20);
    newPhotos.forEach((photo) => {
      photo.images.forEach((image) => {
        const div = document.createElement("div");
        div.className = "masonry-item";
        div.innerHTML = `<a href="${photo.postUrl}" target="_blank"><img loading="lazy" src="${image.thumb}" alt="${image.alt}" /></a>`;
        masonry?.appendChild(div);
      });
    });
    loadedPhotos += 20;
  };

  window.addEventListener("scroll", () => {
    if (window.innerHeight + window.scrollY >= document.body.offsetHeight) {
      loadMorePhotos();
    }
  });
</script>

<style>
  .masonry {
    column-count: 4;
    column-gap: 1rem;
    margin: 1em auto;
  }

  .masonry-item {
    break-inside: avoid;
    margin-bottom: 1rem;
  }

  .masonry-item img {
    width: 100%;
    display: block;
  }

  @media (max-width: 768px) {
    .masonry {
      column-count: 2;
    }
  }

  @media (max-width: 480px) {
    .masonry {
      column-count: 1;
    }

    .masonry-item {
      padding: 0 0.5rem;
    }
  }
</style>
