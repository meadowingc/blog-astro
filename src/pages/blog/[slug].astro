---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return (await getCollection("kittyPosts"))
    .map((col) => col.data)
    .filter((post: any) => post.Published && !post.IsPage)
    .map((post: any) => {
      return {
        params: { slug: `${post.Slug}` },
        props: { post: post },
      };
    });
}

interface Props {
  post: any;
}

// const { slug } = Astro.params;
const { post } = Astro.props;
---

<Layout pageTitle={post.Title}>
  <h1>{post.Title}</h1>
  <p>
    <i>
      <time datetime={post.PublishedDate.toISOString()}>
        {
          post.PublishedDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        }
      </time>
    </i>
  </p>

  <article set:html={post.Body} />

  <p>
    {
      post.Tags.map((tag: string) =>
        /* prettier-ignore */ <a class="tag-link" href={`/tags/${tag}`}>#{tag}</a>
      )
    }
  </p>

  <!-- {
    Object.keys(post).map((key) => (
      <p>
        <strong>{key}</strong>: {JSON.stringify(post[key])}
      </p>
    ))
  } -->
</Layout>

<style>
  .tag-link {
    margin-right: 0.5rem;
  }
</style>
