---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import type { ObsidianPost } from "../../schemas";

export async function getStaticPaths() {
  return (await getCollection("obsidianPublishedPosts"))
    .map((col) => col.data)
    .map((post) => {
      return {
        params: { slug: `${post.slug}` },
        props: { post: post },
      };
    });
}

interface Props {
  post: ObsidianPost;
}

// const { slug } = Astro.params;
const { post } = Astro.props;
---

<Layout pageTitle={post.title}>
  <h1>{post.title}</h1>
  <p>
    <i>
      <time datetime={post.publishedAt.toISOString()}>
        {
          post.publishedAt.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          })
        }
      </time>
    </i>
  </p>

  <article set:html={post.body} />

  <p>
    {post.tags.map((tag: string) => /* prettier-ignore */ <a class="tag-link" href={`/tags/${tag}`}>#{tag}</a>)}
  </p>

  <!-- {
    Object.keys(post).map((key) => (
      <p>
        <strong>{key}</strong>: {JSON.stringify(post[key])}
      </p>
    ))
  } -->
</Layout>

<style>
  .tag-link {
    margin-right: 0.5rem;
  }
</style>
