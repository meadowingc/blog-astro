---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import type { ObsidianPost } from "../../schemas";

export async function getStaticPaths() {
  return (await getCollection("obsidianPublishedPosts"))
    .map((col) => col.data)
    .map((post) => {
      return {
        params: { slug: `${post.slug}` },
        props: { post: post },
      };
    });
}

interface Props {
  post: ObsidianPost;
}

// const { slug } = Astro.params;
const { post } = Astro.props;

// const webmentions = await fetch(`GET https://webmention.io/api/mentions.jf2?target=meadow.cafe&token=6IoMTGKsJgWRMdCK7ilXgw&per-page=1000`)
