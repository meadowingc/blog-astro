---
import { getCollection } from "astro:content";
import AudioPlayer from "../../components/AudioPlayer.astro";
import Backlinks from "../../components/Backlinks.astro";
import Layout from "../../layouts/Layout.astro";
import type { ObsidianPost } from "../../schemas";
import { getBacklinksForPage, type Backlink } from "../../utils/backlinks";

export async function getStaticPaths() {
  const allPosts = (await getCollection("obsidianPublishedPosts"))
    .map((col) => col.data)
    .sort((a, b) => b.publishedAt.getTime() - a.publishedAt.getTime());

  return await Promise.all(
    allPosts.map(async (post, index) => {
      // Get next and previous posts - previous is older, next is newer
      const prevPost = index < allPosts.length - 1 ? allPosts[index + 1] : null;
      const nextPost = index > 0 ? allPosts[index - 1] : null;

      // Get a random post (excluding current)
      const otherPosts = allPosts.filter((p) => p.slug !== post.slug);
      const randomPost = otherPosts[Math.floor(Math.random() * otherPosts.length)];

      // Get backlinks for this post
      const backlinks = await getBacklinksForPage(`/blog/${post.slug}`);

      return {
        params: { slug: `${post.slug}` },
        props: {
          post,
          nextPost,
          prevPost,
          randomPost,
          backlinks,
        },
      };
    }),
  );
}

interface Props {
  post: ObsidianPost;
  nextPost: ObsidianPost | null;
  prevPost: ObsidianPost | null;
  randomPost: ObsidianPost | null;
  backlinks: Backlink[];
}

const { post, nextPost, prevPost, randomPost, backlinks } = Astro.props;

