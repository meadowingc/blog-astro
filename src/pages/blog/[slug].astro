---

<style>
  .mochi_kudos {
    padding: 0.4em 0.8em;
    border: 1px solid #ccc;
    border-radius: 0.5em;
    background-color: inherit;
    color: inherit;
    font-size: 1em;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .mochi_kudos:hover {
    background-color: rgba(0, 0, 0, 0.05);
  }

  .mochi_kudos.did_kudo {
    background-color: #f0fdf4;
    border-color: #86efac;
  }

  @media (prefers-color-scheme: dark) {
    .mochi_kudos {
      border-color: #555;
    }

    .mochi_kudos:hover {
      background-color: rgba(255, 255, 255, 0.08);
    }

    .mochi_kudos.did_kudo {
      background-color: rgba(134, 239, 172, 0.1);
      border-color: rgba(134, 239, 172, 0.4);
    }
  }
</style>

<Layout
  pageTitle={post.title}
  openGraph={{
    title: post.title,
    image: post.metaImage,
    description: post.metaDescription,
    url: `https://meadow.cafe/blog/${post.slug}`,
    type: "article",
    articleTags: post.tags,
    articlePublishedTime: post.publishedAt,
    articleAuthor: "Meadow",
  }}
>
  <style is:inline>
    .obsidian-image img {
      max-width: 100%;
      margin: 0 auto;
      display: block;
    }
  </style>

  <article class="h-entry">
    <header class="post-header">
      <h1 class="p-name">{post.title}</h1>
      {
        post.subtitle && (
          <p class="subtitle">
            <em>{post.subtitle}</em>
          </p>
        )
      }

      <span class="published-date">
        <time class="dt-published" datetime={post.publishedAt.toISOString()}>
          {
            post.publishedAt.toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
              timeZone: "America/Costa_Rica",
            })
          }
        </time>
      </span>
    </header>

    {post.audioVersion && <AudioPlayer audioSrc={post.audioVersion} title={post.title} />}

    <div class="e-content p-name post-content" set:html={post.body} />

    <button class="mochi_kudos"></button>

    <p>
      {post.tags.map((tag: string) => /* prettier-ignore */ <a class="tag-link p-category" href={`/tags/${tag}`}>#{tag}</a>)}
    </p>

    <a hidden rel="author" class="p-author h-card" href="https://meadow.cafe">Meadow</a>
    <a hidden rel="me" href="https://c.im/@meadow">Mastodon</a>

    <link class="u-url" href={`https://meadow.cafe/blog/${post.slug}`} />

    <Backlinks backlinks={backlinks} />

    <nav class="post-navigation">
      <div class="post-nav-links">
        {
          prevPost && (
            <a href={`/blog/${prevPost.slug}`} class="prev-post">
              <span class="nav-arrow">← Older Post</span>
            </a>
          )
        }

        {
          randomPost && (
            <a href={`/blog/${randomPost.slug}`} class="random-post">
              <span class="nav-arrow">↺ Random</span>
            </a>
          )
        }

        {
          nextPost && (
            <a href={`/blog/${nextPost.slug}`} class="next-post">
              <span class="nav-arrow">Newer Post →</span>
            </a>
          )
        }
      </div>
    </nav>
  </article>
</Layout>

<style>
  h1 {
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #999;
    font-size: 1.1em;
    margin: 0.5rem 0 1rem;
  }

  .published-date {
    font-size: 0.85em;
    color: #777;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed rgba(136, 136, 136, 0.3);
  }

  .post-content {
    line-height: 1.7;
  }

  .tag-link {
    margin-right: 0.5rem;
    white-space: nowrap;
    display: inline-block;
  }

  .post-navigation {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eaeaea;
  }

  .post-nav-links {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .post-nav-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    border-radius: 0.25rem;
    text-decoration: none;
    transition:
      background-color 0.2s,
      transform 0.1s;
    flex: 1;
    text-align: center;
  }

  .post-nav-links a:hover {
    background-color: rgba(0, 0, 0, 0.05);
    transform: translateY(-2px);
  }

  .post-nav-links a:active {
    transform: translateY(0px);
  }

  .nav-arrow {
    font-size: 0.9rem;
    color: #666;
  }
  .nav-title {
    font-size: 0.95rem;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .prev-post .nav-arrow,
  .next-post .nav-arrow,
  .random-post .nav-arrow {
    display: inline-block;
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .post-nav-links {
      gap: 0.5rem;
    }

    .post-nav-links a {
      padding: 0.5rem 0.4rem;
      font-size: 0.85rem;
    }

    .nav-arrow {
      font-size: 0.85rem;
    }
  }
</style>
