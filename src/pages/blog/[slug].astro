---

<style>
  .tinylytics_kudos {
    padding: 0;
    margin: 0;
    border: 0;
    background-color: inherit;
    color: inherit;
    font-size: 1.3em;
  }

  .tinylytics_kudos:hover {
    cursor: pointer;
  }

  .tinylytics_kudos:before {
    content: "👋";
  }

  .tinylytics_kudos.did_select:before {
    content: "🥰";
  }
</style>

<Layout
  pageTitle={post.title}
  openGraph={{
    title: post.title,
    image: post.metaImage,
    description: post.metaDescription,
    url: `https://meadow.cafe/blog/${post.slug}`,
    type: "article",
    articleTags: post.tags,
    articlePublishedTime: post.publishedAt,
    articleAuthor: "Meadow",
  }}
>
  <style is:inline>
    .obsidian-image img {
      max-width: 100%;
      margin: 0 auto;
      display: block;
    }
  </style>

  <h1>{post.title}</h1>
  <p>
    <i>
      <time datetime={post.publishedAt.toISOString()}>
        {
          post.publishedAt.toLocaleDateString("en-US", {
            month: "short",
            day: "numeric",
            year: "numeric",
          })
        }
      </time>
    </i>
  </p>

  <article set:html={post.body} />

  <!-- <button class="tinylytics_kudos" data-private="true"> </button> -->

  <p>
    {post.tags.map((tag: string) => /* prettier-ignore */ <a class="tag-link" href={`/tags/${tag}`}>#{tag}</a>)}
  </p>
</Layout>

<style>
  .tag-link {
    margin-right: 0.5rem;
  }
</style>
