---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import WritingHeatmap from "../../components/WritingHeatmap.astro";

const allPosts = (await getCollection("obsidianPublishedPosts"))
  .map((col) => col.data)
  .sort((a, b) => b.publishedAt.getTime() - a.publishedAt.getTime());

const recentPosts = allPosts.slice(0, 10);
const favoritePosts = allPosts.filter((post) => post.isFavorite);

// Calculate word counts for the heatmap
const postEntries = allPosts.map((post) => ({
  date: post.publishedAt,
  wordCount: post.body.split(/\s+/).filter((word) => word.length > 0).length,
}));
---

<style>
  .tag-link {
    margin-right: 0.4rem;
    white-space: nowrap;
    display: inline-block;
  }
</style>

<Layout pageTitle={"Blog"}>
  <h1 id="blog">Blog</h1>

  <WritingHeatmap entries={postEntries} weeks={37} />

  <p>
    For all my blog posts, please see the archive page <a href="/blog/archive">here</a>.
  </p>

  <section>
    <h2>Recent Posts</h2>
    <ul class="embedded blog-posts">
      {
        recentPosts.map((post) => (
          <li>
            <span>
              <i>
                <time datetime={post.publishedAt.toISOString()}>
                  {post.publishedAt.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                    timeZone: "America/Costa_Rica",
                  })}
                </time>
              </i>
            </span>
            <a href={`/blog/${post.slug}`}>{post.title}</a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    favoritePosts.length > 0 && (
      <section>
        <h2>Favorite Posts</h2>
        <ul class="embedded blog-posts">
          {favoritePosts.map((post) => (
            <li>
              <span>
                <i>
                  <time datetime={post.publishedAt.toISOString()}>
                    {post.publishedAt.toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                      timeZone: "America/Costa_Rica",
                    })}
                  </time>
                </i>
              </span>
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section>
    <h2>Tags</h2>
    <p>
      {
        allPosts
          .flatMap((post) => post.tags)
          .filter((tag, index, array) => array.indexOf(tag) === index)
          .sort()
          .map((tag) => /* prettier-ignore */ <a class="tag-link" href={`/tags/${tag}`}>#{tag}</a>)
      }
    </p>
  </section>
</Layout>
