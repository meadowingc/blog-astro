---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const allPosts = (await getCollection("obsidianPublishedPosts"))
  .map((col) => col.data)
  .sort((a, b) => b.publishedAt.getTime() - a.publishedAt.getTime());
---

<Layout pageTitle={"Blog"}>
  <h1 id="blog">Blog</h1>
  <p></p>

  <ul class="embedded blog-posts">
    {
      allPosts
        .filter((st) => st.slug)
        .map((st) => (
          <li>
            <span>
              <i>
                <time datetime={st.publishedAt.toISOString()}>
                  {st.publishedAt.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              </i>
            </span>
            <a href={`/blog/${st.slug}`}>{st.title}</a>
          </li>
        ))
    }
  </ul>
</Layout>
