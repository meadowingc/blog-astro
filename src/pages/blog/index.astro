---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const allPosts = (await getCollection("kittyPosts"))
  .map((col) => col.data)
  .filter((post: any) => post.Published && !post.IsPage)
  .sort((a: any, b: any) => b.PublishedDate - a.PublishedDate);
---

<Layout pageTitle={"Blog"}>
  <h1 id="blog">Blog</h1>
  <p></p>

  <ul class="embedded blog-posts">
    {
      allPosts
        .filter((st: any) => st.Slug)
        .map((st: any) => (
          <li>
            <span>
              <i>
                <time datetime={st.PublishedDate.toISOString()}>
                  {st.PublishedDate.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
              </i>
            </span>
            <a href={`/blog/${st.Slug}`}>{st.Title}</a>
          </li>
        ))
    }
  </ul>
</Layout>
