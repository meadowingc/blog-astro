---
import { getCollection } from "astro:content";
import Backlinks from "../../components/Backlinks.astro";
import Layout from "../../layouts/Layout.astro";
import type { NowPage } from "../../schemas";
import { getBacklinksForPage, type Backlink } from "../../utils/backlinks";

export async function getStaticPaths() {
  const sortedNowPages = (await getCollection("historicalNowPages"))
    .map((col) => col.data)
    .sort((a, b) => b.date.getTime() - a.date.getTime());

  return await Promise.all(
    sortedNowPages.map(async (nowPage) => {
      const backlinks = await getBacklinksForPage(`/now/${nowPage.slug}`);
      return {
        params: { slug: nowPage.slug },
        props: { nowPage, backlinks },
      };
    }),
  );
}

interface Props {
  nowPage: NowPage;
  backlinks: Backlink[];
}

const { nowPage, backlinks } = Astro.props;
---

<Layout
  pageTitle={nowPage.title}
  openGraph={{
    title: nowPage.title,
    description: `What I was up to on ${nowPage.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "America/Costa_Rica" })}`,

    url: `https://meadow.cafe/now/${nowPage.slug}`,
    type: "article",
  }}
>
  <article class="h-entry">
    <h1 class="p-name">{nowPage.title}</h1>

    <div class="e-content" set:html={nowPage.body} />

    <nav class="now-navigation">
      <p>
        <a href="/now">← Back to current Now page</a> |
        <a href="/now/archive">All Now pages</a>
      </p>
    </nav>

    <a hidden rel="author" class="p-author h-card" href="https://meadow.cafe">Meadow</a>
    <link class="u-url" href={`https://meadow.cafe/now/${nowPage.slug}`} />
    <a hidden rel="me" href="https://c.im/@meadow">Mastodon</a>

    <Backlinks backlinks={backlinks} />
  </article>
</Layout>

<style>
  .now-navigation {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eaeaea;
    text-align: center;
  }

  .now-navigation a {
    text-decoration: none;
    color: #666;
  }

  .now-navigation a:hover {
    text-decoration: underline;
  }
</style>
