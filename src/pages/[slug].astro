---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import type { ObsidianPage } from "../schemas";
import { getBacklinksForPage, type Backlink } from "../utils/backlinks";

export async function getStaticPaths() {
  const allPages = (await getCollection("obsidianPublishedPages")).map((col) => col.data);

  return await Promise.all(
    allPages.map(async (page) => {
      const backlinks = await getBacklinksForPage(`/${page.slug}`);
      return {
        params: { slug: `${page.slug}` },
        props: { page, backlinks },
      };
    }),
  );
}

interface Props {
  page: ObsidianPage;
  backlinks: Backlink[];
}

const { page, backlinks } = Astro.props;
---

<Layout pageTitle={page.title}>
  <article set:html={page.body} />
  <!-- <Backlinks backlinks={backlinks} /> -->
</Layout>
