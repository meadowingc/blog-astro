---
import { getCollection } from "astro:content";
import Backlinks from "../../components/Backlinks.astro";
import Layout from "../../layouts/Layout.astro";
import type { ObsidianDream } from "../../schemas";
import { getBacklinksForPage, type Backlink } from "../../utils/backlinks";

export async function getStaticPaths() {
  const allDreams = (await getCollection("obsidianPublishedDreams")).map((col) => col.data);

  return await Promise.all(
    allDreams.map(async (dream) => {
      const backlinks = await getBacklinksForPage(`/dreams/${dream.slug}`);
      return {
        params: { slug: `${dream.slug}` },
        props: { dream, backlinks },
      };
    }),
  );
}

interface Props {
  dream: ObsidianDream;
  backlinks: Backlink[];
}

const { dream, backlinks } = Astro.props;
---

<Layout
  pageTitle={dream.title}
  openGraph={{
    title: dream.title,
    image: dream.metaImage,
    description: dream.metaDescription,
    url: `https://meadow.cafe/dreams/${dream.slug}`,
    type: "article",
    articlePublishedTime: dream.publishedAt,
    articleAuthor: "Meadow",
  }}
>
  <style is:inline>
    .obsidian-image img {
      max-width: 100%;
      margin: 0 auto;
      display: block;
    }
  </style>

  <article class="h-entry">
    <h1 class="p-name">{dream.title}</h1>
    <p>
      <i>
        <time class="dt-published" datetime={dream.publishedAt.toISOString()}>
          {
            dream.publishedAt.toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
              timeZone: "America/Costa_Rica",
            })
          }
        </time>
      </i>
    </p>

    <div class="e-content p-name" set:html={dream.body} />

    <a hidden rel="author" class="p-author h-card" href="https://meadow.cafe">Meadow</a>
    <link class="u-url" href={`https://meadow.cafe/dreams/${dream.slug}`} />
    <a hidden rel="me" href="https://c.im/@meadow">Mastodon</a>

    <Backlinks backlinks={backlinks} />
  </article>
</Layout>

<style>
  .tag-link {
    margin-right: 0.5rem;
    white-space: nowrap;
    display: inline-block;
  }
</style>
