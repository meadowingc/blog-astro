---
export interface Props {
  audioSrc: string;
  title: string;
}

const { audioSrc, title } = Astro.props;
const audioId = `audio-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="audio-player-container">
  <div class="audio-player" data-audio-src={audioSrc} data-audio-id={audioId} data-audio-title={title}>
    <button id={`play-${audioId}`} class="play-btn">
      <span class="play-icon">▶</span>
      <span class="pause-icon" style="display: none;">⏸</span>
    </button>
    <div id={audioId} class="waveform">
      <span class="waveform-placeholder">listen to audio version</span>
    </div>
    <span class="time-display" id={`time-${audioId}`} style="visibility: hidden;">
      <span id={`current-${audioId}`}>0:00</span>/<span id={`duration-${audioId}`}>0:00</span>
    </span>
    <button class="audio-info-tooltip" aria-label="Audio info">
      ?
      <span class="audio-info-popup">
        This is an AI-generated audio version using my voice. For more info see <a
          href="/blog/0064-making-audio-versions-of-my-posts/">this post</a
        >.
      </span>
    </button>
  </div>
</div>

<script>
  import WaveSurfer from "wavesurfer.js";

  // Find all audio players on the page and initialize them
  document.addEventListener("DOMContentLoaded", () => {
    const audioPlayers = document.querySelectorAll(".audio-player[data-audio-src]");

    audioPlayers.forEach((playerElement) => {
      const htmlElement = playerElement as HTMLElement;
      const audioSrc = htmlElement.dataset.audioSrc;
      const audioId = htmlElement.dataset.audioId;

      const container = document.getElementById(audioId!) as HTMLElement;
      const playBtn = document.getElementById(`play-${audioId}`) as HTMLButtonElement;
      const playIcon = playBtn?.querySelector(".play-icon") as HTMLElement;
      const pauseIcon = playBtn?.querySelector(".pause-icon") as HTMLElement;
      const currentTimeEl = document.getElementById(`current-${audioId}`) as HTMLElement;
      const durationEl = document.getElementById(`duration-${audioId}`) as HTMLElement;

      if (!container || !playBtn || !playIcon || !pauseIcon || !currentTimeEl || !durationEl) return;

      function formatTime(seconds: number) {
        const minutes = Math.floor(seconds / 60);
        const remainingSeconds = Math.floor(seconds % 60);
        return `${minutes}:${remainingSeconds.toString().padStart(2, "0")}`;
      }

      let wavesurfer: WaveSurfer | null = null;

      function initWaveSurfer() {
        // Show time display
        const timeDisplay = document.getElementById(`time-${audioId}`);
        if (timeDisplay) timeDisplay.style.visibility = "visible";

        // Replace placeholder with loading text
        const placeholder = container.querySelector(".waveform-placeholder");
        if (placeholder) {
          placeholder.textContent = "loading audio...";
          placeholder.classList.replace("waveform-placeholder", "waveform-loading");
        }

        wavesurfer = WaveSurfer.create({
          container: container,
          waveColor: "var(--text-color)",
          progressColor: "var(--link-color)",
          cursorColor: "var(--link-color)",
          barWidth: 1,
          barGap: 1,
          height: 40,
          normalize: true,
          url: audioSrc!,
        });

        wavesurfer.on("timeupdate", (currentTime) => {
          currentTimeEl.textContent = formatTime(currentTime);
        });

        // Show duration early from media element metadata
        const mediaEl = wavesurfer.getMediaElement();
        mediaEl.addEventListener(
          "loadedmetadata",
          () => {
            if (mediaEl.duration && isFinite(mediaEl.duration)) {
              durationEl.textContent = formatTime(mediaEl.duration);
            }
          },
          { once: true },
        );

        wavesurfer.on("ready", () => {
          durationEl.textContent = formatTime(wavesurfer!.getDuration());
          container.querySelector(".waveform-loading")?.remove();
        });

        wavesurfer.on("play", () => {
          playIcon.style.display = "none";
          pauseIcon.style.display = "inline";
        });

        wavesurfer.on("pause", () => {
          playIcon.style.display = "inline";
          pauseIcon.style.display = "none";
        });

        wavesurfer.on("finish", () => {
          playIcon.style.display = "inline";
          pauseIcon.style.display = "none";
        });

        wavesurfer.on("interaction", () => {
          wavesurfer!.play();
        });

        return wavesurfer;
      }

      // Clicking the placeholder also triggers load
      container.querySelector(".waveform-placeholder")?.addEventListener("click", () => {
        playBtn.click();
      });

      playBtn.addEventListener("click", () => {
        if (!wavesurfer) {
          const ws = initWaveSurfer();
          ws.once("ready", () => ws.play());
        } else {
          wavesurfer.playPause();
        }
      });
    });

    // Toggle tooltip popups on click/tap
    document.querySelectorAll(".audio-info-tooltip").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const popup = btn.querySelector(".audio-info-popup") as HTMLElement;
        if (!popup) return;
        const isVisible = popup.style.display === "block";
        // Close all open popups first
        document.querySelectorAll(".audio-info-popup").forEach((p: any) => (p.style.display = "none"));
        if (!isVisible) popup.style.display = "block";
      });
    });

    // Close popups when clicking elsewhere
    document.addEventListener("click", () => {
      document.querySelectorAll(".audio-info-popup").forEach((p: any) => (p.style.display = "none"));
    });
  });
</script>

<style>
  .audio-player-container {
    margin: 1.5rem 0;
    padding: 1rem 0;
    border-top: 1px dotted var(--text-color);
    border-bottom: 1px dotted var(--text-color);
  }

  .audio-label {
    font-family: var(--font-secondary);
    font-size: 0.9rem;
    color: var(--em-color);
    font-style: italic;
  }

  .audio-player {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .play-btn {
    background: transparent;
    color: var(--text-color);
    border: 1px solid var(--text-color);
    border-radius: 2px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.7rem;
    transition: all 0.15s ease;
    font-family: var(--font-secondary);
    flex-shrink: 0;
  }

  .play-btn:hover {
    background: var(--text-color);
    color: var(--background-color);
  }

  .waveform {
    flex: 1;
    opacity: 0.8;
    border-radius: 1px;
    overflow: hidden;
    min-width: 0;
    position: relative;
    min-height: 40px;
  }

  .waveform-placeholder,
  .waveform-loading {
    position: absolute;
    inset: 0;
    font-family: var(--font-secondary);
    font-size: 0.75rem;
    color: var(--text-color);
    opacity: 0.4;
    font-style: italic;
    line-height: 40px;
    display: block;
    text-align: center;
    pointer-events: none;
  }

  .waveform-placeholder {
    cursor: pointer;
    pointer-events: auto;
    opacity: 0.5;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
  }

  .waveform-placeholder:hover {
    opacity: 0.8;
  }

  .time-display {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    color: var(--text-color);
    opacity: 0.6;
    flex-shrink: 0;
    min-width: 70px;
    text-align: right;
  }

  .audio-info-tooltip {
    font-family: var(--font-secondary);
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--text-color) 50%, transparent);
    cursor: pointer;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--text-color) 50%, transparent);
    border-radius: 50%;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
    position: relative;
    padding: 0;
  }

  .audio-info-tooltip:hover {
    color: color-mix(in srgb, var(--text-color) 80%, transparent);
    border-color: color-mix(in srgb, var(--text-color) 80%, transparent);
  }

  .audio-info-popup {
    display: none;
    position: absolute;
    bottom: calc(100% + 8px);
    right: 0;
    background: var(--background-color, #fff);
    border: 1px solid var(--text-color);
    border-radius: 4px;
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    line-height: 1.4;
    white-space: normal;
    width: 200px;
    z-index: 10;
    opacity: 1;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  @media (max-width: 600px) {
    .audio-player-container {
      margin: 1rem 0;
      padding: 0.75rem 0;
    }

    .audio-player {
      gap: 0.5rem;
    }

    .play-btn {
      width: 24px;
      height: 24px;
      font-size: 0.6rem;
    }

    .time-display {
      font-size: 0.75rem;
      min-width: 60px;
    }

    .audio-info-tooltip {
      width: 14px;
      height: 14px;
      font-size: 0.7rem;
    }
  }
</style>
