---
import { SITE_EMAIL } from "../consts";

interface Props {
  postTitle: string;
  blueskyUrl?: string;
  mastodonUrl?: string;
}

const { postTitle, blueskyUrl, mastodonUrl } = Astro.props;
const mailtoUrl = `mailto:${SITE_EMAIL}?subject=${encodeURIComponent(`RE: ${postTitle}`)}`;
---

<aside class="social-links">
  <span class="social-links-label">Follow up on</span>
  <a href={mailtoUrl} class="social-pill"> ✉️ Email </a>
  {
    blueskyUrl && (
      <a href={blueskyUrl} target="_blank" rel="noopener noreferrer" class="social-pill">
        🔗 Bluesky
      </a>
    )
  }
  {
    mastodonUrl && (
      <a href={mastodonUrl} target="_blank" rel="noopener noreferrer" class="social-pill">
        🔗 Mastodon
      </a>
    )
  }
</aside>

<style>
  .social-links {
    margin-top: 2rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .social-links-label {
    font-size: 0.9rem;
    color: #555;
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    padding: 0.25rem 0.6rem;
    background: rgba(0, 0, 0, 0.04);
    border-radius: 9999px;
    font-size: 0.85rem;
    transition:
      background-color 0.2s,
      transform 0.1s;
  }

  .social-pill:hover {
    background: rgba(0, 0, 0, 0.08);
    transform: translateY(-1px);
  }

  .social-pill:active {
    transform: translateY(0);
  }

  @media (prefers-color-scheme: dark) {
    .social-links-label {
      color: #aaa;
    }

    .social-pill {
      background: rgba(255, 255, 255, 0.05);
    }

    .social-pill:hover {
      background: rgba(255, 255, 255, 0.1);
    }
  }
</style>
